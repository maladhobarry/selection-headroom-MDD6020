# Data are downloaded, never committed
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results are regenerated by `make all`; commit them only for a tagged release
results/logs/*
!results/logs/.gitkeep

# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
*.part
*.log
